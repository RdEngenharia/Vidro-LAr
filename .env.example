# Firebase — configuração do projeto (vitri-pro)
VITE_FIREBASE_API_KEY="..."
VITE_FIREBASE_AUTH_DOMAIN="vitri-pro.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="vitri-pro"
VITE_FIREBASE_STORAGE_BUCKET="vitri-pro.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="..."
VITE_FIREBASE_APP_ID="..."

# Mercado Pago — chave PÚBLICA (vai pro navegador, é assim mesmo). A chave
# secreta (MERCADO_PAGO_ACCESS_TOKEN) NUNCA vai aqui — ela é configurada só
# nas Cloud Functions, via `firebase functions:secrets:set`.
VITE_MP_PUBLIC_KEY="..."
